<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The ports a connector fills. Eyu is MIT and consumed in-process; Formbase is reached only over
      HTTP, never as a package — the process boundary is where saem's licence stops.
    -->
    <PackageVersion Include="Eyu.Core" Version="0.10.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- The MCP server: the protocol SDK over Streamable HTTP, and bearer-token validation. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
