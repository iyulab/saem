<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Materialization: the instance edges of the ontology's relations, built ahead of a question from what
    one group may read — read through sessions opened with that group's account, so a row the group may
    not see leaves no edge. An edge carries which entity leads to which and the record it was read from,
    never the record's body. The edges are kept in the group's own Formbase, written over its HTTP surface
    with nothing but the edge's own fields.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Saem.Query\Saem.Query.csproj" />
    <!-- Eyu's Fellegi–Sunter linkage scores the identities that name a linkage rule (saem D-87). No model is called:
         linkage is arithmetic over the compared fields, and this is the materialization side, never a lookup's path. -->
    <PackageReference Include="Eyu.Core" />
  </ItemGroup>

</Project>
