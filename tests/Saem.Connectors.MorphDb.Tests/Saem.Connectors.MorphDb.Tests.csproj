<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    Live tests read a MorphDB service that accepts tokens from a key the test holds, reached at
    SAEM_MORPHDB_URL with its master secret in SAEM_MORPHDB_MASTER_SECRET:
      dotnet test -p:IncludeMorphDbLiveTests=true
    Excluded by default, so the suite never depends on a running service.
  -->
  <ItemGroup Condition="'$(IncludeMorphDbLiveTests)' != 'true'">
    <Compile Remove="Live/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Saem.Connectors.MorphDb\Saem.Connectors.MorphDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
