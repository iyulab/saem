<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    The server started in-process on a loopback port, with tokens signed by a key the test holds and
    sources the test fakes. Live tests (Live/) run the same server against the rig's issuer and mes
    source — see tests/rig/compose.password-login.yaml — and are excluded unless IncludeRigLiveTests=true.
  -->
  <ItemGroup Condition="'$(IncludeRigLiveTests)' != 'true'">
    <Compile Remove="Live/**/*.cs" />
  </ItemGroup>

  <!--
    LiveForms/ runs the server against the rig's forms source (tests/rig/compose.morphdb.yaml), where the
    person's token itself reaches the source; excluded unless IncludeMorphDbLiveTests=true.
  -->
  <ItemGroup Condition="'$(IncludeMorphDbLiveTests)' != 'true'">
    <Compile Remove="LiveForms/**/*.cs" />
  </ItemGroup>

  <!-- The one-run test drafts its ontology from the forms with Eyu before asking saem. -->
  <ItemGroup Condition="'$(IncludeMorphDbLiveTests)' == 'true'">
    <ProjectReference Include="..\..\src\Saem.Authoring\Saem.Authoring.csproj" />
    <ProjectReference Include="..\..\src\Saem.Connectors.Formbase\Saem.Connectors.Formbase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Saem.Mcp\Saem.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
