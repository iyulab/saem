<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    Against a real Formbase instance over HTTP, reached at SAEM_FORMBASE_URL (for example the bundle
    formbase's docker-compose.yml stands up). Needs a Formbase that serves the raw stream.
      SAEM_FORMBASE_URL=http://127.0.0.1:8080 dotnet test -p:IncludeFormbaseLiveTests=true
    Excluded by default, so the suite never depends on a running service.
  -->
  <ItemGroup Condition="'$(IncludeFormbaseLiveTests)' != 'true'">
    <Compile Remove="Live/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Saem.Connectors.Formbase\Saem.Connectors.Formbase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
