{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "rig",
      "tokenExpiry": 20,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "pat",
          "claims": {
            "sub": "${clientId}",
            "scope": "${scope}",
            "aud": ["${audience}"],
            "groups": ["g-plant"]
          }
        },
        {
          "requestParam": "client_id",
          "match": "quinn",
          "claims": {
            "sub": "${clientId}",
            "scope": "${scope}",
            "aud": ["${audience}"],
            "groups": ["g-plant"]
          }
        },
        {
          "requestParam": "client_id",
          "match": "olive",
          "claims": {
            "sub": "${clientId}",
            "scope": "${scope}",
            "aud": ["${audience}"],
            "groups": ["g-office"]
          }
        },
        {
          "requestParam": "client_id",
          "match": "agent-for-alice",
          "claims": {
            "sub": "alice",
            "act": { "sub": "agent-7" },
            "scope": "${scope}",
            "aud": ["${audience}"]
          }
        },
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "${clientId}",
            "scope": "${scope}",
            "aud": ["${audience}"]
          }
        },
        {
          "requestParam": "actor_token_type",
          "match": "urn:ietf:params:oauth:token-type:access_token",
          "claims": {
            "aud": ["${audience}"],
            "act": { "sub": "${clientId}" }
          }
        },
        {
          "requestParam": "grant_type",
          "match": "urn:ietf:params:oauth:grant-type:token-exchange",
          "claims": {
            "aud": ["${audience}"]
          }
        }
      ]
    },
    {
      "issuerId": "elsewhere",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "${clientId}",
            "scope": "${scope}",
            "aud": ["${audience}"]
          }
        }
      ]
    }
  ]
}
