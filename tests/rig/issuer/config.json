{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "rig",
      "tokenExpiry": 20,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "${clientId}",
            "scope": "${scope}",
            "aud": ["${audience}"]
          }
        },
        {
          "requestParam": "grant_type",
          "match": "urn:ietf:params:oauth:grant-type:token-exchange",
          "claims": {
            "aud": ["${audience}"]
          }
        }
      ]
    },
    {
      "issuerId": "elsewhere",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "${clientId}",
            "scope": "${scope}",
            "aud": ["${audience}"]
          }
        }
      ]
    }
  ]
}
